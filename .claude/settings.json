{
  "permissions": {
    "allow": [
      "Bash(bash tests/run.sh)",
      "Bash(bash -n scripts/*.sh scripts/board/*.sh tests/*.sh)",
      "Bash(npx --yes shellcheck -S style -x scripts/*.sh scripts/board/*.sh tests/*.sh)",
      "Bash(scripts/release-prep.sh --check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
