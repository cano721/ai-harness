  "release_policy": {
    "flow": "tag",
    "evidence": [
      "origin has main and develop",
      "vX.Y.Z tags on origin",
      "version files .claude-plugin/plugin.json, .codex-plugin/plugin.json, release.json",
      "CHANGELOG.md has ## vX.Y.Z sections"
    ],
    "base": "main",
    "source": "develop",
    "branch_prefix": "release/v",
    "tag_prefix": "v",
    "prepare_cmd": "scripts/release-prep.sh \"$HM_RELEASE_VERSION\"",
    "notes_cmd": "scripts/changelog-section.sh \"$HM_RELEASE_VERSION\"",
    "generate_notes": true,
    "verify_cmd": "scripts/release-verify.sh \"$HM_RELEASE_VERSION\"",
    "verify_timeout_minutes": 60,
    "record_cmds": [
      "scripts/release-milestone.sh \"$HM_RELEASE_VERSION\""
    ]
  }
