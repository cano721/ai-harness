{
  "version": 1,
  "scope": "project-template",
  "name": "release",
  "entry": "plan",
  "terminals": ["done", "user_decision"],
  "nodes": {
    "plan": {"write": false, "actor": "agent", "output": "release_plan"},
    "approval": {"write": false, "actor": "human", "output": "approved_plan"},
    "prepare": {"write": true, "actor": "driver", "output": "release_commit"},
    "revalidate": {"write": true, "actor": "driver", "output": "caught_up_branch"},
    "publish": {"write": true, "actor": "agent", "network": true, "output": "pull_request"},
    "remote_ci": {"write": false, "actor": "agent", "network": true, "output": "remote_ci_result"},
    "merge": {"write": false, "actor": "driver", "network": true, "output": "merge_result"},
    "post_merge_verify": {"write": false, "actor": "agent", "network": true, "output": "post_merge_evidence"},
    "release": {"write": false, "actor": "driver", "network": true, "output": "published_release"},
    "verify": {"write": false, "actor": "driver", "commands": true, "output": "release_verification"},
    "record": {"write": false, "actor": "driver", "commands": true, "output": "release_record"},
    "sync": {"write": false, "actor": "driver", "network": true, "output": "sync_instructions"},
    "done": {"write": false, "actor": "terminal", "output": "release_report"},
    "user_decision": {"write": false, "actor": "human", "output": "blocker_report"}
  },
  "transitions": [
    {"from": "plan", "to": "approval", "when": "plan_valid"},
    {"from": "plan", "to": "user_decision", "when": "plan_invalid"},
    {"from": "approval", "to": "plan", "when": "brief_changed_or_not_approved"},
    {"from": "approval", "to": "prepare", "when": "user_explicitly_approved"},
    {"from": "approval", "to": "prepare", "when": "auto_approved_by_policy"},
    {"from": "prepare", "to": "publish", "when": "prepared"},
    {"from": "prepare", "to": "user_decision", "when": "prepare_failed"},
    {"from": "publish", "to": "revalidate", "when": "source_moved"},
    {"from": "publish", "to": "remote_ci", "when": "published_or_not_required"},
    {"from": "publish", "to": "user_decision", "when": "publish_failed"},
    {"from": "revalidate", "to": "publish", "when": "caught_up"},
    {"from": "revalidate", "to": "user_decision", "when": "catch_up_failed"},
    {"from": "remote_ci", "to": "done", "when": "remote_ci_passed_or_not_required"},
    {"from": "remote_ci", "to": "merge", "when": "remote_ci_passed_and_merge_policy"},
    {"from": "remote_ci", "to": "user_decision", "when": "remote_ci_failed"},
    {"from": "remote_ci", "to": "user_decision", "when": "remote_ci_unverified"},
    {"from": "merge", "to": "revalidate", "when": "source_moved"},
    {"from": "merge", "to": "post_merge_verify", "when": "merged"},
    {"from": "merge", "to": "user_decision", "when": "merge_blocked"},
    {"from": "post_merge_verify", "to": "release", "when": "post_merge_verified"},
    {"from": "post_merge_verify", "to": "user_decision", "when": "post_merge_failed_or_unverified"},
    {"from": "release", "to": "verify", "when": "released_and_deploy_level"},
    {"from": "release", "to": "record", "when": "released"},
    {"from": "release", "to": "user_decision", "when": "release_failed"},
    {"from": "verify", "to": "record", "when": "verified_or_skipped"},
    {"from": "verify", "to": "user_decision", "when": "verify_failed"},
    {"from": "record", "to": "sync", "when": "recorded"},
    {"from": "record", "to": "user_decision", "when": "record_failed"},
    {"from": "sync", "to": "done"}
  ],
  "invariants": [
    "No write-capable node is reachable before the current release plan is approved: user_explicitly_approved, or auto_approved_by_policy when the user setting HM_APPROVAL or HM_APPROVAL_REPOS resolves to auto and the plan records its choices as decisions with nothing left in needs_human or open_questions.",
    "The release is merged only with a merge commit: the merge node never squashes or rebases, whatever the host allows, and a repository that does not allow merge commits ends at user_decision as merge_blocked.",
    "No tag or release is created without notes: an empty or failing notes command ends at user_decision before any tag is pushed, and an existing tag is never created again.",
    "When the source branch moves, the release branch catches up and the checks run again before it is published or merged: a rebase before the first push, a merge after it, and a conflict ends at user_decision with no rebase or merge left in progress.",
    "Neither an agent nor the driver force-pushes or pushes to the source or base branch: the main to develop fast-forward is left to a person as a command in the report.",
    "A failed prepare, check, remote CI, merge, notes, verify, or record step ends at user_decision; a release run never repairs code."
  ]
}
