#!/usr/bin/env bash
# workflow-driver 테스트용 가짜 codex. 프롬프트의 노드 이름과 FAKE_SCENARIO로 동작을 고른다.
set -euo pipefail
[[ "${1:-}" == exec ]] || exit 64
shift
dir="" sandbox="" out="" schema="" net="" adddir=""
while (($#)); do
  case "$1" in
    -C) dir="$2"; shift 2 ;;
    -s) sandbox="$2"; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    --output-schema) schema="$2"; shift 2 ;;
    -c) [[ "$2" == sandbox_workspace_write.network_access=true ]] && net=yes; shift 2 ;;
    --add-dir) adddir="$2"; shift 2 ;;
    *) shift ;;
  esac
done
prompt="$(cat)"
case "$prompt" in
  *"You are the discover node"*) node=discover ;;
  *"You are the triage node"*) node=triage ;;
  *"You are the reproduce node"*) node=reproduce ;;
  *"You are the regression node"*) node=regression ;;
  *"You are the fix node"*) node=fix ;;
  *"You are the scope node"*) node=scope ;;
  *"You are the inspect node"*) node=inspect ;;
  *"You are the re_review node"*) node=re_review ;;
  *"You are the brief node"*) node=brief ;;
  *"You are the deliver node"*) node=deliver ;;
  *"You are the review node"*) node=review ;;
  *"You are the ui_review node"*) node=ui_review ;;
  *"You are the repair node"*) node=repair ;;
  *"You are the publish node"*) node=publish ;;
  *"You are the remote_ci node"*) node=remote_ci ;;
  *"You are the post_merge_verify node"*) node=post_merge_verify ;;
  *) node=unknown ;;
esac
printf '%s %s schema=%s%s%s\n' "$node" "$sandbox" "${schema:+yes}" "${net:+ net=yes}" "${adddir:+ add-dir=yes}" >>"$FAKE_LOG"
cd "$dir"
scenario="${FAKE_SCENARIO:-ok}"
check="${FAKE_CHECK:-true}"
case "$prompt" in *"Revise it with this feedback"*) printf '%s\n' "$prompt" >"$FAKE_LOG.revise" ;; esac
printf '%s\n' "$prompt" >"$FAKE_LOG.$node.prompt"
# approval auto면 러너가 decisions·needs_human 스키마를 준다. 기본 응답은 받은 스키마를 따른다.
auto=""
[[ -n "$schema" ]] && jq -e '.properties.decisions' "$schema" >/dev/null 2>&1 && auto=yes
case "$node:$scenario" in
  discover:brief_writes) echo sneaky >sneaky.txt; printf 'contract\n' >"$out" ;;
  discover:*) printf 'contract\n' >"$out" ;;
  triage:*) printf 'observed: total is wrong; expected: total adds tax\n' >"$out" ;;
  reproduce:repro_blocked) jq -n '{status:"blocked", summary:"needs production-like data", evidence:[], hypothesis:"", needed:["a sample order export"]}' >"$out" ;;
  reproduce:repro_hollow) jq -n '{status:"reproduced", summary:"reproduced", evidence:[], hypothesis:"tax skipped", needed:[]}' >"$out" ;;
  reproduce:repro_writes) echo log >repro.log; jq -n '{status:"reproduced", summary:"x", evidence:["x"], hypothesis:"", needed:[]}' >"$out" ;;
  reproduce:*) [[ -n "$adddir" ]] && echo 'FAIL total' >"$adddir/run.log"
    jq -n '{status:"reproduced", summary:"total misses tax", evidence:["npm test -- total: expected 110, got 100"], hypothesis:"tax is skipped for zero discounts", needed:[]}' >"$out" ;;
  regression:bug_noop) printf 'nothing\n' >"$out" ;;
  regression:*) mkdir -p tests; echo 'expect 110' >tests/total.test; printf 'regression test added\n' >"$out" ;;
  fix:bug_noop|fix:bug_fix_noop) printf 'nothing\n' >"$out" ;;
  fix:*) echo v1 >feature.txt; printf 'fixed\n' >"$out" ;;
  scope:scope_bad_base) jq -n --arg c "$check" '{summary:"x", base:"no-such-ref", files:[], checks:[$c]}' >"$out" ;;
  scope:scope_nocheck) jq -n '{summary:"review the uncommitted change", base:"HEAD", files:["feature.txt"], checks:[]}' >"$out" ;;
  scope:*) jq -n --arg c "$check" '{summary:"review the uncommitted change", base:"HEAD", files:["feature.txt"], checks:[$c]}' >"$out" ;;
  inspect:rv_clean*|inspect:scope_bad_base) jq -n '{summary:"ok", blocking_findings:[], non_blocking_findings:[], needs_user_decision:false, ui_scenarios:[]}' >"$out" ;;
  inspect:rv_decision) jq -n '{summary:"x", blocking_findings:["pricing rule unclear"], non_blocking_findings:[], needs_user_decision:true, ui_scenarios:[]}' >"$out" ;;
  inspect:rv_ui) jq -n '{summary:"ok", blocking_findings:[], non_blocking_findings:[], needs_user_decision:false, ui_scenarios:["심사자: 목록 -> 반려 -> 반려됨 확인"]}' >"$out" ;;
  inspect:*) jq -n '{summary:"x", blocking_findings:["feature.txt: missing case"], non_blocking_findings:[], needs_user_decision:false, ui_scenarios:[]}' >"$out" ;;
  re_review:rv_new_finding)
    if [[ -f "$FAKE_LOG.new_finding" ]]; then
      jq -n '{summary:"ok", blocking_findings:[], non_blocking_findings:[], needs_user_decision:false}' >"$out"
    else
      touch "$FAKE_LOG.new_finding"
      jq -n '{summary:"x", blocking_findings:["auth flow must be redesigned"], non_blocking_findings:[], needs_user_decision:false}' >"$out"
    fi ;;
  re_review:rv_always_blocks) jq -n '{summary:"x", blocking_findings:["still missing"], non_blocking_findings:[], needs_user_decision:false}' >"$out" ;;
  re_review:*) jq -n '{summary:"ok", blocking_findings:[], non_blocking_findings:[], needs_user_decision:false}' >"$out" ;;
  brief:auto_questions) jq -n --arg c "$check" '{brief:"# Brief", checks:[$c], open_questions:["which plan tier?"]}' >"$out" ;;
  brief:auto_decisions) jq -n --arg c "$check" '{brief:"# Brief\n- add feature.txt", checks:[$c],
    decisions:[{question:"which plan tier?", choice:"free tier only", rationale:"smallest scope that meets the request"}], needs_human:[]}' >"$out" ;;
  brief:auto_needs_human) jq -n --arg c "$check" '{brief:"# Brief", checks:[$c],
    decisions:[{question:"which plan tier?", choice:"free tier only", rationale:"smallest scope"}], needs_human:["drop the legacy plans table?"]}' >"$out" ;;
  brief:auto_legacy) jq -n --arg c "$check" '{brief:"# Brief", checks:[$c], open_questions:[]}' >"$out" ;;
  brief:nocheck) jq -n '{brief:"# Brief", checks:[], open_questions:[]}' >"$out" ;;
  brief:ui_*) jq -n --arg c "$check" '{brief:"# Brief\n- add feature.txt", checks:[$c], open_questions:[],
    ui_scenarios:["심사자: 승인 대기 목록 진입 -> 반려 사유 입력 후 반려 -> 반려됨 확인 -> 목록 복귀 (접힌 기본 상태, 데스크톱·390px, 라이트)"]}' >"$out" ;;
  brief:*)
    if [[ -n "$auto" ]]; then
      jq -n --arg c "$check" '{brief:"# Brief\n- add feature.txt", checks:[$c], decisions:[], needs_human:[]}' >"$out"
    else
      jq -n --arg c "$check" '{brief:"# Brief\n- add feature.txt", checks:[$c], open_questions:[]}' >"$out"
    fi ;;
  deliver:noop) printf 'nothing\n' >"$out" ;;
  deliver:commit) echo v1 >feature.txt; git add feature.txt; git commit -qm sneaky; printf 'done\n' >"$out" ;;
  deliver:screen_backstop) mkdir -p templates; echo '<summary>반려하기</summary>' >templates/approve.html; printf 'delivered\n' >"$out" ;;
  deliver:*) echo v1 >feature.txt; printf 'delivered\n' >"$out" ;;
  repair:*) echo fixed >feature.txt; printf 'repaired\n' >"$out" ;;
  publish:publish_unpushed) git add -A; git commit -qm "feat: add feature" || true; jq -n '{summary:"x", branch:"main", pr_url:""}' >"$out" ;;
  publish:*)
    [[ "$(git rev-parse --abbrev-ref HEAD)" == feat/add-feature ]] || git checkout -q -b feat/add-feature
    git add -A
    git commit -qm "feat: add feature" || true
    git push -q -u origin HEAD 2>/dev/null
    case "$scenario" in
      merge_*|pm_*) url="https://github.com/acme/app/pull/7" ;;
      *) url="https://example.test/pr/7" ;;
    esac
    jq -n --arg u "$url" '{summary:"opened", branch:"feat/add-feature", pr_url:$u}' >"$out" ;;
  remote_ci:ci_fail_once)
    if [[ -f "$FAKE_LOG.ci_failed" ]]; then
      jq -n --arg c "$(git rev-parse HEAD)" '{status:"passed", commit:$c, summary:"2 checks passed", failures:[]}' >"$out"
    else
      touch "$FAKE_LOG.ci_failed"
      jq -n --arg c "$(git rev-parse HEAD)" '{status:"failed", commit:$c, summary:"1 of 2 checks failed",
        failures:["test (ubuntu): expected 12:00:00.123456 but was 12:00:00.123456789"]}' >"$out"
    fi ;;
  remote_ci:ci_always_fail) jq -n --arg c "$(git rev-parse HEAD)" '{status:"failed", commit:$c, summary:"1 of 2 checks failed", failures:["test (ubuntu): still red"]}' >"$out" ;;
  remote_ci:ci_unverified) jq -n '{status:"unverified", commit:"", summary:"no CI tool or token for this host", failures:[]}' >"$out" ;;
  remote_ci:ci_pending) jq -n --arg c "$(git rev-parse HEAD)" '{status:"pending", commit:$c, summary:"build still running", failures:[]}' >"$out" ;;
  remote_ci:ci_stale) jq -n --arg c "$(git rev-parse HEAD~1)" '{status:"passed", commit:$c, summary:"2 checks passed", failures:[]}' >"$out" ;;
  remote_ci:ci_rewrites_remote) git push -qf origin HEAD~1:refs/heads/feat/add-feature 2>/dev/null
    jq -n --arg c "$(git rev-parse HEAD)" '{status:"passed", commit:$c, summary:"2 checks passed", failures:[]}' >"$out" ;;
  remote_ci:merge_ci_none) jq -n --arg c "$(git rev-parse HEAD)" '{status:"none", commit:$c, summary:"no CI configuration in the repository", failures:[]}' >"$out" ;;
  remote_ci:ci_none*) jq -n --arg c "$(git rev-parse HEAD)" '{status:"none", commit:$c, summary:"no CI configuration in the repository", failures:[]}' >"$out" ;;
  remote_ci:*) jq -n --arg c "$(git rev-parse HEAD)" '{status:"passed", commit:$c, summary:"2 checks passed", failures:[]}' >"$out" ;;
  post_merge_verify:pm_ci_fail) jq -n '{status:"failed", commit:"1111111111111111111111111111111111111111", summary:"build on main failed", failures:["integration: db migration timed out"]}' >"$out" ;;
  post_merge_verify:pm_ci_other) jq -n '{status:"passed", commit:"3333333", summary:"green", failures:[]}' >"$out" ;;
  post_merge_verify:*) jq -n '{status:"passed", commit:"1111111111111111111111111111111111111111", summary:"main is green", failures:[]}' >"$out" ;;
  review:bad_review) printf 'looks good to me\n' >"$out" ;;
  review:review_blocks) jq -n '{summary:"x", blocking_findings:["missing case"], non_blocking_findings:[], needs_user_decision:false}' >"$out" ;;
  review:decision) jq -n '{summary:"x", blocking_findings:["pricing rule unclear"], non_blocking_findings:[], needs_user_decision:true}' >"$out" ;;
  review:*) jq -n '{summary:"ok", blocking_findings:[], non_blocking_findings:[], needs_user_decision:false}' >"$out" ;;
  ui_review:ui_writes) echo capture >capture.png; jq -n '{status:"verified", summary:"ok", scenarios:[], blocking_findings:[], non_blocking_findings:[], unverified:[]}' >"$out" ;;
  ui_review:ui_issues_once)
    if [[ -f "$FAKE_LOG.ui_failed" ]]; then
      echo capture >"$adddir/default.png"
      jq -n '{status:"verified", summary:"반려 버튼이 기본 상태에서 버튼으로 보인다", scenarios:[{scenario:"반려", viewport:"1440", theme:"light", actions:"click", captures:["default.png"], result:"ok"}], blocking_findings:[], non_blocking_findings:[], unverified:[]}' >"$out"
    else
      touch "$FAKE_LOG.ui_failed"
      jq -n '{status:"issues", summary:"반려하기가 일반 텍스트처럼 보인다", scenarios:[], non_blocking_findings:[], unverified:[],
        blocking_findings:["반려하기 summary에 펼침 표시가 없어 기본 상태에서 조작 요소로 보이지 않는다"]}' >"$out"
    fi ;;
  ui_review:ui_unverified) jq -n '{status:"unverified", summary:"앱 서버를 띄우지 못했다", scenarios:[], blocking_findings:[], non_blocking_findings:[],
    unverified:["모든 시나리오: 로그인 계정이 문서에 없다"]}' >"$out" ;;
  ui_review:ui_hollow) jq -n '{status:"verified", summary:"looks fine", scenarios:[], blocking_findings:[], non_blocking_findings:[], unverified:[]}' >"$out" ;;
  ui_review:ui_partial) jq -n '{status:"verified", summary:"desktop ok", scenarios:[{scenario:"반려", viewport:"1440", theme:"light", actions:"click", captures:["default.png"], result:"ok"}], blocking_findings:[], non_blocking_findings:[], unverified:["390px: 브라우저 에뮬레이션 실패"]}' >"$out" ;;
  ui_review:ui_fake_capture) echo note >"$adddir/notes.txt"
    jq -n '{status:"verified", summary:"ok", scenarios:[{scenario:"반려", viewport:"1440", theme:"light", actions:"click", captures:["default.png"], result:"ok"}], blocking_findings:[], non_blocking_findings:[], unverified:[]}' >"$out" ;;
  ui_review:ui_empty_issues) jq -n '{status:"issues", summary:"뭔가 이상하다", scenarios:[], blocking_findings:[], non_blocking_findings:[], unverified:[]}' >"$out" ;;
  ui_review:*) [[ -n "$adddir" ]] && echo capture >"$adddir/default.png"
    jq -n '{status:"verified", summary:"모든 시나리오를 렌더링·조작했다", scenarios:[{scenario:"반려", viewport:"1440", theme:"light", actions:"click", captures:["default.png"], result:"ok"}], blocking_findings:[], non_blocking_findings:[], unverified:[]}' >"$out" ;;
  *) exit 1 ;;
esac
