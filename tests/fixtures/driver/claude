#!/usr/bin/env bash
# implement-feature-driver 테스트용 가짜 claude. 노드 동작은 가짜 codex에 맡기고 stream-json 이벤트로 감싼다.
# 도구 입출력에 비밀 표식을 넣어, 러너가 원본 스트림을 디스크에 남기지 않는지 확인하게 한다.
set -euo pipefail
sandbox=read-only schema="" stream=""
while (($#)); do
  case "$1" in
    --permission-mode) [[ "$2" == acceptEdits ]] && sandbox=workspace-write; shift 2 ;;
    --json-schema) schema="$(mktemp)"; printf '%s\n' "$2" >"$schema"; shift 2 ;;
    --output-format) [[ "$2" == stream-json ]] && stream=yes; shift 2 ;;
    --tools|--allowedTools) shift 2 ;;
    *) shift ;;
  esac
done
[[ -n "$stream" ]] || exit 64
out="$(mktemp)"
jq -nc --arg f "$PWD/src/app.ts" '{type:"system", subtype:"init"}, {type:"assistant", message:{content:[
  {type:"text", text:"MODEL-TEXT-SECRET"},
  {type:"tool_use", name:"Read", input:{file_path:$f}},
  {type:"tool_use", name:"Bash", input:{command:"curl -H \"Authorization: Bearer CMD-SECRET\" https://x", description:"call the api"}}]}},
  {type:"user", message:{content:[{type:"tool_result", content:"FILE-CONTENT-SECRET"}]}}'
[[ "${FAKE_CLAUDE_FAIL:-}" == 1 ]] && exit 1
codex exec -C "$PWD" -s "$sandbox" -o "$out" ${schema:+--output-schema "$schema"}
if [[ -n "$schema" ]]; then
  jq -c '{type:"result", subtype:"success", result:tojson, structured_output:.}' "$out"
else
  jq -Rsc '{type:"result", subtype:"success", result:.}' "$out"
fi
