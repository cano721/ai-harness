#!/usr/bin/env bash
# workflow-driver 테스트용 가짜 gh. FAKE_SCENARIO와 $FAKE_LOG.* 표시 파일로 PR 상태를 정한다.
#   merged 표시가 있으면 MERGED, approved 표시가 있으면 head에 대한 승인이 있다(merge_ok·merge_*_fail·pm_*는 처음부터 승인).
set -euo pipefail
MERGE_SHA=1111111111111111111111111111111111111111
scenario="${FAKE_SCENARIO:-ok}"
# gh api: 기준 브랜치 보호 규칙. FAKE_PROTECTION=classic|ruleset|none|checks_only|denied (기본 none)
#   저장소 설정(허용 병합 방식): FAKE_MERGE_METHODS=all|merge_only|squash_only|rebase_only|unknown|denied (기본 all)
#   릴리스(rel_* 시나리오): gh release create는 태그를 원격(bare)에 push하고, pr merge는 원격 main을 릴리스 브랜치 head로 옮긴다.
#   rel_release_fail은 release create가 실패한다. gh run list는 FAKE_RUN_STATUS(completed:success 기본)를 답한다.
if [[ "${1:-}" == release ]]; then
  printf 'gh release %s\n' "${*:2}" >>"$FAKE_LOG"
  [[ "${2:-}" == create ]] || exit 64
  [[ "${FAKE_SCENARIO:-}" != rel_release_fail ]] || { echo "HTTP 422: Validation Failed" >&2; exit 1; }
  git push -q origin "HEAD:refs/tags/$3"
  exit 0
fi
if [[ "${1:-} ${2:-}" == "run list" ]]; then
  printf 'gh run list %s\n' "${*:3}" >>"$FAKE_LOG"
  status="${FAKE_RUN_STATUS:-completed:success}"
  jq -cn --arg s "${status%%:*}" --arg c "${status#*:}" '[{status:$s, conclusion:(if $c == "" then null else $c end), headBranch:"v1.3.0"}]'
  exit 0
fi
if [[ "${1:-}" == api ]]; then
  printf 'gh api %s\n' "$2" >>"$FAKE_LOG"
  protection="${FAKE_PROTECTION:-none}"
  case "$2" in
    */rules/branches/*)
      case "$protection" in
        ruleset) echo '[{"type":"pull_request","parameters":{"required_approving_review_count":2}},{"type":"deletion"}]' ;;
        checks_only) echo '[{"type":"required_status_checks","parameters":{"required_status_checks":[{"context":"ci"}]}}]' ;;
        denied) echo "gh: Resource not accessible by integration (HTTP 403)" >&2; exit 1 ;;
        *) echo '[]' ;;
      esac ;;
    */protection)
      case "$protection" in
        classic) echo '{"required_pull_request_reviews":{"required_approving_review_count":1},"required_status_checks":{"contexts":["ci"]}}' ;;
        denied) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
        *) echo "gh: Branch not protected (HTTP 404)" >&2; exit 1 ;;
      esac ;;
    repos/*/*/*) exit 64 ;;
    repos/*/*)
      case "${FAKE_MERGE_METHODS:-all}" in
        all) echo '{"allow_squash_merge":true,"allow_merge_commit":true,"allow_rebase_merge":true}' ;;
        merge_only) echo '{"allow_squash_merge":false,"allow_merge_commit":true,"allow_rebase_merge":false}' ;;
        squash_only) echo '{"allow_squash_merge":true,"allow_merge_commit":false,"allow_rebase_merge":false}' ;;
        rebase_only) echo '{"allow_squash_merge":false,"allow_merge_commit":false,"allow_rebase_merge":true}' ;;
        unknown) echo '{"name":"app"}' ;;
        denied) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
      esac ;;
    *) exit 64 ;;
  esac
  exit 0
fi
[[ "${1:-} ${2:-}" == "pr view" || "${1:-} ${2:-}" == "pr merge" ]] || exit 64
sub="$2"
shift 2
printf 'gh %s %s\n' "$sub" "$*" >>"$FAKE_LOG"
head="$(git rev-parse HEAD)"
if [[ "$sub" == merge ]]; then
  [[ "$scenario" != merge_cmd_fail ]] || { echo "GraphQL: Pull request is not mergeable" >&2; exit 1; }
  touch "$FAKE_LOG.merged"
  # 릴리스: 호스트가 병합한 것처럼 원격 main을 릴리스 브랜치 head로 옮긴다(main → develop ff 판정이 실제 ref를 본다).
  case "$scenario" in rel_*) git push -q origin HEAD:refs/heads/main ;; esac
  case "$scenario" in # 병합 뒤 worktree 판정 테스트: 병합 직후 작업 폴더에 미커밋 변경이 생긴다
    wtc_dirty) printf 'stray\n' >"$PWD/stray.txt" ;;
  esac
  exit 0
fi
[[ "$scenario" != merge_host_down ]] || { echo "HTTP 502" >&2; exit 1; }
approved=no
case "$scenario" in merge_wait*|merge_noapproval) [[ -f "$FAKE_LOG.approved" ]] && approved=yes ;; *) approved=yes ;; esac
reviews='[]'
if [[ "$approved" == yes ]]; then
  reviews="$(jq -cn --arg h "$head" '[{author:{login:"alice"}, authorAssociation:"MEMBER", state:"APPROVED", submittedAt:"2026-10-30T01:00:00Z", commit:{oid:$h}}]')"
fi
r() { # login association state time commit
  jq -cn --arg l "$1" --arg a "$2" --arg s "$3" --arg t "$4" --arg c "$5" '{author:{login:$l}, authorAssociation:$a, state:$s, submittedAt:$t, commit:{oid:$c}}'
}
case "$scenario" in
  merge_stale) reviews="[$(r alice MEMBER APPROVED 2026-10-30T01:00:00Z 0000000)]" ;;
  merge_self) reviews="[$(r me OWNER APPROVED 2026-10-30T01:00:00Z "$head")]" ;;
  merge_outsider) reviews="[$(r stranger CONTRIBUTOR APPROVED 2026-10-30T01:00:00Z "$head")]" ;;
  merge_bot) reviews="[$(r helper[bot] MEMBER APPROVED 2026-10-30T01:00:00Z "$head")]" ;;
  merge_dismissed) reviews="[$(r alice MEMBER APPROVED 2026-10-30T01:00:00Z "$head"),$(r alice MEMBER DISMISSED 2026-10-30T02:00:00Z "$head")]" ;;
  merge_rereviewed) reviews="[$(r alice MEMBER CHANGES_REQUESTED 2026-10-30T01:00:00Z "$head"),$(r alice MEMBER APPROVED 2026-10-30T02:00:00Z "$head")]" ;;
  merge_changes|merge_conflict_changes) reviews="[$(r alice MEMBER APPROVED 2026-10-30T01:00:00Z "$head"),$(r bob COLLABORATOR CHANGES_REQUESTED 2026-10-30T02:00:00Z "$head")]" ;;
esac
state=OPEN; merge_commit=null; merged_at=""
if [[ -f "$FAKE_LOG.merged" || "$scenario" == merge_outside ]]; then state=MERGED; merge_commit="{\"oid\":\"$MERGE_SHA\"}"; merged_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; fi
[[ "$scenario" != merge_closed ]] || state=CLOSED
[[ "$scenario" != wtc_unmerged || ! -f "$FAKE_LOG.reopen" ]] || state=OPEN  # 병합 뒤 검증이 표시를 남기면 호스트가 더는 MERGED로 답하지 않는다
[[ "$scenario" != merge_headmoved ]] || head=2222222222222222222222222222222222222222
# merge_conflict*: base와 충돌한다. sync_base가 base를 병합해 head가 merge 커밋이 되면 풀린다(merge_conflict_limit은 계속 충돌).
mergeable=MERGEABLE
case "$scenario" in
  merge_conflict_limit) mergeable=CONFLICTING ;;
  merge_conflict*) git rev-parse -q --verify HEAD^2 >/dev/null || mergeable=CONFLICTING ;;
esac
base=main
[[ "$scenario" != merge_otherbase ]] || base=release
head_ref=feat/add-feature
case "$scenario" in rel_*) head_ref="$(git rev-parse --abbrev-ref HEAD)" ;; esac
checks='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SUCCESS"}]'
[[ "$scenario" != merge_hostci_fail ]] || checks='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"FAILURE"},{"__typename":"StatusContext","state":"SUCCESS"}]'
draft=false
[[ "$scenario" != merge_draft ]] || draft=true
jq -n --arg s "$state" --argjson d "$draft" --arg m "$mergeable" --arg h "$head" --argjson r "$reviews" --argjson mc "$merge_commit" \
  --arg b "$base" --arg ma "$merged_at" --argjson c "$checks" --arg hr "$head_ref" \
  '{state:$s, isDraft:$d, mergeable:$m, headRefOid:$h, headRefName:$hr, baseRefName:$b, reviews:$r, author:{login:"me"},
    mergeCommit:$mc, mergedAt:(if $ma == "" then null else $ma end), statusCheckRollup:$c}'
