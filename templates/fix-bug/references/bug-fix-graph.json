{
  "version": 1,
  "scope": "project-template",
  "name": "bug-fix",
  "entry": "triage",
  "terminals": ["done", "user_decision"],
  "nodes": {
    "triage": {"write": false, "output": "bug_facts"},
    "reproduce": {"write": false, "commands": true, "output": "reproduction_evidence"},
    "brief": {"write": false, "output": "bug_fix_brief"},
    "approval": {"write": false, "output": "approved_bug_fix_brief"},
    "regression": {"write": true, "output": "regression_evidence"},
    "fix": {"write": true, "output": "fix_evidence"},
    "verify": {"write": false, "output": "verification_evidence"},
    "review": {"write": false, "output": "findings"},
    "ui_review": {"write": false, "browser": true, "output": "ui_review_report"},
    "repair": {"write": true, "output": "repair_evidence"},
    "publish": {"write": true, "network": true, "output": "pull_request"},
    "remote_ci": {"write": false, "network": true, "output": "remote_ci_result"},
    "done": {"write": false, "output": "handoff"},
    "user_decision": {"write": false, "output": "blocker_report"}
  },
  "transitions": [
    {"from": "triage", "to": "reproduce"},
    {"from": "reproduce", "to": "brief", "when": "reproduced_or_evidence_sufficient"},
    {"from": "reproduce", "to": "user_decision", "when": "cannot_reproduce_and_no_observation_plan"},
    {"from": "brief", "to": "approval"},
    {"from": "approval", "to": "brief", "when": "brief_changed_or_not_approved"},
    {"from": "approval", "to": "regression", "when": "user_explicitly_approved"},
    {"from": "approval", "to": "regression", "when": "auto_approved_by_policy"},
    {"from": "regression", "to": "fix"},
    {"from": "fix", "to": "verify"},
    {"from": "verify", "to": "review", "when": "required_checks_pass"},
    {"from": "verify", "to": "repair", "when": "required_checks_fail"},
    {"from": "review", "to": "publish", "when": "no_blocking_findings"},
    {"from": "review", "to": "repair", "when": "blocking_findings"},
    {"from": "review", "to": "ui_review", "when": "no_blocking_findings_ui_affected"},
    {"from": "ui_review", "to": "publish", "when": "ui_verified"},
    {"from": "ui_review", "to": "repair", "when": "ui_issues"},
    {"from": "ui_review", "to": "user_decision", "when": "ui_unverified"},
    {"from": "repair", "to": "verify"},
    {"from": "repair", "to": "user_decision", "when": "repair_limit_reached_or_product_or_environment_decision"},
    {"from": "publish", "to": "remote_ci", "when": "published_or_not_required"},
    {"from": "publish", "to": "user_decision", "when": "publish_failed"},
    {"from": "remote_ci", "to": "done", "when": "remote_ci_passed_or_not_required"},
    {"from": "remote_ci", "to": "repair", "when": "remote_ci_failed"},
    {"from": "remote_ci", "to": "user_decision", "when": "remote_ci_unverified"}
  ],
  "limits": {"max_repair_attempts": 10},
  "invariants": [
    "No write-capable node is reachable before the current brief is approved: user_explicitly_approved, or auto_approved_by_policy when .ai-harness/harness.json sets approval to auto and the brief has no open questions.",
    "A bug fix is not complete without reproduction or explicit equivalent verification evidence.",
    "A blocking finding cannot transition directly to done.",
    "Every repair is followed by required checks and re-review.",
    "publish commits, pushes, and opens a PR only as .ai-harness/harness.json git_policy allows; it never merges, force-pushes, or pushes to the base branch.",
    "Work that was pushed is not done until remote CI for the pushed commit has finished green or the repository has no remote CI; local runs of the CI commands do not stand in for it, a failure goes back through repair, and remote CI that cannot be observed ends as unverified, never as done.",
    "A change with ui_scenarios is not done until ui_review has rendered and operated them in a browser with no blocking UI finding; ui_review follows the project ui-review contract, does not change the working tree, and a UI that could not be verified ends at user_decision as unverified, never as done."
  ]
}
